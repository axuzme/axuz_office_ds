+def axuz_deploy_server_sources(server_dir, root_dir):
+  import os, subprocess
+  dst = root_dir + "/server"
+  node_prefix = os.environ.get("AXUZ_NODE_PREFIX", "")
+  for sub, entry, name in (("DocService", "sources/server.js", "docservice"), ("FileConverter", "sources/convertermaster.js", "converter"), ("Metrics", "node_modules/statsd/bin/statsd", "metrics")):
+    base.create_dir(dst + "/" + sub)
+    for item in ("sources", "package.json", "npm-shrinkwrap.json", "config", "metrics.js", "public"):
+      src = server_dir + "/" + sub + "/" + item
+      if base.is_exist(src):
+        if base.is_dir(src):
+          base.copy_dir(src, dst + "/" + sub + "/" + item)
+        else:
+          base.copy_file(src, dst + "/" + sub + "/" + item)
+    # node_modules so de producao (npm ci ja instalou tudo; poda dev) sem binarios de outras plataformas
+    subprocess.check_call("rsync -a --delete --exclude='*.md' --exclude='test' --exclude='tests' --exclude='.bin' " + server_dir + "/" + sub + "/node_modules/ " + dst + "/" + sub + "/node_modules/ 2>/dev/null || true", shell=True)
+    launcher = dst + "/" + sub + "/" + name
+    base.writeFile(launcher, "#!/bin/sh\n# AXUZ launcher (sem pkg): cd no diretorio do servico e roda o node do artefato.\nDIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\ncd \"$DIR\" && exec \"$DIR/../../node/bin/node\" \"$DIR/" + entry + "\" \"$@\"\n")
+    os.chmod(launcher, 0o755)
+  base.create_dir(dst + "/Common")
+  for item in ("sources", "package.json", "npm-shrinkwrap.json"):
+    src = server_dir + "/Common/" + item
+    if base.is_exist(src):
+      (base.copy_dir if base.is_dir(src) else base.copy_file)(src, dst + "/Common/" + item)
+  subprocess.check_call("rsync -a --delete --exclude='*.md' --exclude='test' --exclude='tests' " + server_dir + "/Common/node_modules/ " + dst + "/Common/node_modules/ 2>/dev/null || true", shell=True)
+  # node proprio (compilado do fonte, MIT) + licenca
+  base.create_dir(root_dir + "/node/bin")
+  base.copy_file(node_prefix + "/bin/node", root_dir + "/node/bin/node")
+  os.chmod(root_dir + "/node/bin/node", 0o755)
+  if base.is_exist(node_prefix + "/share/doc/node/LICENSE"):
+    base.copy_file(node_prefix + "/share/doc/node/LICENSE", root_dir + "/node/LICENSE")
+
 def make():
