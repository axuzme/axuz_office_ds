+def axuz_build_native_modules(addon_dir):
+  # AXUZ: modulos nativos compilados do fonte contra o node proprio (headers locais, sem baixar nada):
+  # sharp usa libvips da distro (SHARP_FORCE_GLOBAL_LIBVIPS=1, sem download de libvips pre-compilado).
+  nodedir = os.environ.get("AXUZ_NODE_PREFIX", "")
+  env_save = dict(os.environ)
+  os.environ["npm_config_nodedir"] = nodedir
+  os.environ["SHARP_FORCE_GLOBAL_LIBVIPS"] = "1"
+  for sub in ("DocService", "Metrics", "FileConverter", "Common"):
+    d = addon_dir + "/" + sub
+    for mod in ("sharp", "modern-syslog"):
+      if base.is_dir(d + "/node_modules/" + mod):
+        base.cmd_in_dir(d, "npm", ["rebuild", mod, "--build-from-source", "--foreground-scripts"])
+  os.environ.clear()
+  os.environ.update(env_save)
 
