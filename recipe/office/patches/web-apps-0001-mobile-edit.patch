+                isLink = true;
+            }
+        });
+
+        if (stack.length > 0 && isEdit && !isDisconnected) {
+            const unlocked = !lockedText && !lockedTable && !lockedImage && !lockedHeader;
+
+            if (unlocked && canCopy) {
