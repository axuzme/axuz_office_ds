+    storeFocusObjects.intf = {
+        // Lista de strings que decide quais abas a UI mostra.
+        filterFocusObjects: () => {
+            const settings = [];
+            const add = name => settings.indexOf(name) < 0 && settings.push(name);
+            for (const object of objs()) {
+                const type = object.get_ObjectType();
+                const value = object.get_ObjectValue();
+                if (type === T().Header) add('header');
+                else if (type === T().Paragraph) { add('paragraph'); add('text'); }
+                else if (type === T().Table) add('table');
+                else if (type === T().Hyperlink) add('hyperlink');
+                else if (type === T().Image && value) {
+                    if (value.get_ChartProperties()) add('chart');
+                    else if (value.get_ShapeProperties()) add('shape');
+                    else add('image');
+                }
+            }
+            return settings;
+        },
+        getHeaderObject: () => topValue(objs(), o => o.get_ObjectType() === T().Header),
+        getParagraphObject: () => topValue(objs(), o => o.get_ObjectType() === T().Paragraph),
+        getShapeObject: () => topValue(objs(), o => isImage(o) && !!o.get_ObjectValue() && !!o.get_ObjectValue().get_ShapeProperties()),
+        getImageObject: () => topValue(objs(), o => {
+            const v = isImage(o) ? o.get_ObjectValue() : null;
