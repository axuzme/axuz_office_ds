+
+            const isObject = isShape || isChart || isImage || isTable;
+            const hideAddComment = !canViewComments || api.can_AddQuotedComment() === false || !unlocked || (!isText && isObject);
+            if (!hideAddComment) itemsText.push({ caption: _t.menuAddComment, event: 'addcomment' });
+        }
+
+        if (isLink) {
+            itemsText.push({ caption: _t.menuOpenLink, event: 'openlink' });
+            if (isEdit && stack.length > 0)
+                itemsText.push({ caption: _t.menuEditLink, event: 'editlink' });
+        }
+
+        // Em telefone, mostra no maximo 2 itens de texto e o resto vai em "Mais".
+        ctx.extraItems = [];
+        if (Device.phone && itemsText.length > 2) {
