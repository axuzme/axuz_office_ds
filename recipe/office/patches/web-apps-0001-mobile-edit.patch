+
+        stack.forEach(item => {
+            const type = item.get_ObjectType(), value = item.get_ObjectValue();
+            if (type === Asc.c_oAscTypeSelectElement.Header) {
+                lockedHeader = value.get_Locked();
+            } else if (type === Asc.c_oAscTypeSelectElement.Paragraph) {
+                lockedText = value.get_Locked();
