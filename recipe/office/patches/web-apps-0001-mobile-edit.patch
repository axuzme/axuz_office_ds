+            case 'copy': return !!api.Copy();
+            case 'paste': return !!api.Paste();
+            case 'addcomment': Common.Notifications.trigger('addcomment'); return true;
+            case 'merge': api.MergeCells(); return true;
+            case 'split': ctx.showSplitModal(); return true;
+            case 'delete': api.asc_Remove(); return true;
+            case 'deletetable': api.remTable(); return true;
+            case 'edit': setTimeout(() => ctx.props.openOptions('edit'), 400); return true;
+            case 'addlink': setTimeout(() => ctx.props.openOptions('add', 'link'), 400); return true;
+            case 'editlink': setTimeout(() => ctx.props.openOptions('edit-link'), 400); return true;
+            default: return false;
+        }
+    },
 };
 
 export default EditorUIController;
