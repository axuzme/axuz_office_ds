+ *       delegam para `intf`; `settings` alimenta as abas de editar/adicionar.
+ */
+EditorUIController.initFocusObjects = (storeFocusObjects) => {
+    const T = () => Asc.c_oAscTypeSelectElement;
+    const objs = () => storeFocusObjects._focusObjects || [];
+    const isImage = o => o.get_ObjectType() === T().Image;
