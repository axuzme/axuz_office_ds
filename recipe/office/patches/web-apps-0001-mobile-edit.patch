+        const itemsIcon = [], itemsText = [];
+
+        if (canCopy) itemsIcon.push({ event: 'copy', icon: 'icon-copy' });
+
+        let isText = false, isTable = false, isImage = false, isChart = false, isShape = false, isLink = false,
